rule (modulo E) Reveal_LtkTPM:
   [ !LtkTPM( $A, aik ) ] --[ RevealedTPM( $A ) ]-> [ Out( aik ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_LtkTEE:
   [ !LtkTEE( $A, tsk ) ] --[ RevealedTEE( $A ) ]-> [ Out( tsk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromise_LeafSw:
   [ !LtkLeaf( $L, cdi ) ] --[ CompromisedLeaf( $L ) ]-> [ Out( cdi ) ]

  /* has exactly the trivial AC variant */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction Unique_LeafEnrollment:
  "∀ L #i #j. ((OnlyOnceL( L ) @ #i) ∧ (OnlyOnceL( L ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ L #i #j. ((OnlyOnceL( L ) @ #i) ∧ (OnlyOnceL( L ) @ #j)) ⇒ (#i = #j)"
  */

restriction Unique_TPMEnrollment:
  "∀ A #i #j. ((OnlyOnceT( A ) @ #i) ∧ (OnlyOnceT( A ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A #i #j. ((OnlyOnceT( A ) @ #i) ∧ (OnlyOnceT( A ) @ #j)) ⇒ (#i = #j)"
  */

restriction Unique_TEEEnrollment:
  "∀ A #i #j. ((OnlyOnceE( A ) @ #i) ∧ (OnlyOnceE( A ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A #i #j. ((OnlyOnceE( A ) @ #i) ∧ (OnlyOnceE( A ) @ #j)) ⇒ (#i = #j)"
  */

restriction Roster_Distinct:
  "∀ x #i. (RosterDistinct( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (RosterDistinct( x, x ) @ #i) ⇒ (⊥)"
  */

restriction Unique_Roster:
  "∀ A #i #j. ((OnlyOnceR( A ) @ #i) ∧ (OnlyOnceR( A ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A #i #j. ((OnlyOnceR( A ) @ #i) ∧ (OnlyOnceR( A ) @ #j)) ⇒ (#i = #j)"
  */

restriction Unique_Epoch:
  "∀ e #i #j.
    ((UniqueEpoch( e ) @ #i) ∧ (UniqueEpoch( e ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ e #i #j.
    ((UniqueEpoch( e ) @ #i) ∧ (UniqueEpoch( e ) @ #j)) ⇒ (#i = #j)"
  */

lemma executability:
  exists-trace
  "∃ V A epoch evset #i.
    (((Accept( V, A, epoch, evset ) @ #i) ∧
      (¬(∃ X #j. RevealedTPM( X ) @ #j))) ∧
     (¬(∃ X #j. RevealedTEE( X ) @ #j))) ∧
    (¬(∃ X #j. CompromisedLeaf( X ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ V A epoch evset #i.
  (Accept( V, A, epoch, evset ) @ #i)
 ∧
  (∀ X #j. (RevealedTPM( X ) @ #j) ⇒ ⊥) ∧
  (∀ X #j. (RevealedTEE( X ) @ #j) ⇒ ⊥) ∧
  (∀ X #j. (CompromisedLeaf( X ) @ #j) ⇒ ⊥)"
*/
simplify
solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
  case Verifier_StartSession
  solve( !PkTPM( $A, pk(x) ) ▶₁ #i )
    case Register_AggrTPM
    solve( !PkLeaf( $L1, pk(x) ) ▶₂ #i )
      case Register_LeafDICE
      solve( !PkLeaf( $L2, pk(x) ) ▶₃ #i )
        case Register_LeafDICE
        solve( !PkLeaf( $L3, pk(x) ) ▶₄ #i )
          case Register_LeafDICE
          solve( !RosterOf( $A, $L1, $L2, $L3 ) ▶₅ #i )
            case Publish_Roster
            solve( !KU( sign(<'LEAF_EV', $L1, $A, $V, ~epoch, ~n, m1>, ~cdi)
                   ) @ #vk.17 )
              case Leaf_Attest_case_1
              solve( !KU( sign(<'LEAF_EV', $L2, $A, $V, ~epoch, ~n, m2>, ~cdi.1)
                     ) @ #vk.24 )
                case Leaf_Attest_case_2
                solve( !KU( sign(<'LEAF_EV', $L3, $A, $V, ~epoch, ~n, m3>, ~cdi.2)
                       ) @ #vk.29 )
                  case Leaf_Attest_case_3
                  solve( !KU( sign(<'AGG_EV', $A, $V, ~epoch, ~n, 
                                    h(<~m, sign(<'LEAF_EV', $L1, $A, $V, ~epoch, ~n, ~m>, ~cdi), ~m.1, 
                                       sign(<'LEAF_EV', $L2, $A, $V, ~epoch, ~n, ~m.1>, ~cdi.1), ~m.2, 
                                       sign(<'LEAF_EV', $L3, $A, $V, ~epoch, ~n, ~m.2>, ~cdi.2)>), 
                                    h(<$L1, $L2, $L3>)>,
                                   ~aik)
                         ) @ #vk.30 )
                    case Aggregator_Quote_Fixed
                    solve( !KU( sign(<'TPM', $A, 'g'^~ta, gb_in>, ~aik) ) @ #vk.51 )
                      case TPM_respond
                      solve( !KU( ~epoch ) @ #vk.38 )
                        case Verifier_StartSession
                        solve( !KU( ~n ) @ #vk.49 )
                          case Verifier_StartSession
                          solve( !KU( ~m ) @ #vk.46 )
                            case Leaf_Attest
                            solve( !KU( ~m.1 ) @ #vk.47 )
                              case Leaf_Attest
                              solve( !KU( ~m.2 ) @ #vk.48 )
                                case Leaf_Attest
                                solve( !KU( sign(<'TEE', $A, 'g'^~ta>, ~tsk) ) @ #vk.57 )
                                  case TEE_send
                                  solve( !KU( 'g'^~ta ) @ #vk.57 )
                                    case TEE_send
                                    solve( !KU( 'g'^~tb ) @ #vk.56 )
                                      case TPM_respond
                                      SOLVED // trace found
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma key_secrecy:
  all-traces
  "∀ A k #i.
    (((SessionKey( A, k ) @ #i) ∧ (¬(∃ #j. RevealedTPM( A ) @ #j))) ∧
     (¬(∃ #j. RevealedTEE( A ) @ #j))) ⇒
    (¬(∃ #m. K( k ) @ #m))"
/*
guarded formula characterizing all counter-examples:
"∃ A k #i.
  (SessionKey( A, k ) @ #i)
 ∧
  (∀ #j. (RevealedTPM( A ) @ #j) ⇒ ⊥) ∧
  (∀ #j. (RevealedTEE( A ) @ #j) ⇒ ⊥) ∧
  (∃ #m. (K( k ) @ #m))"
*/
simplify
solve( St_TEE( $A, ~ta, pk(x) ) ▶₀ #i )
  case TEE_send
  solve( !KU( sign(<'TPM', $A, 'g'^~ta, gb_in>, ~aik) ) @ #vk.6 )
    case TPM_respond
    solve( !KU( 'g'^(~ta*~tb) ) @ #vk.8 )
      case TEE_send
      by solve( !KU( ~tb ) @ #vk.14 )
    next
      case TPM_respond
      by solve( !KU( ~ta ) @ #vk.14 )
    next
      case c_exp
      by solve( !KU( ~ta ) @ #vk.16 )
    qed
  next
    case c_sign
    solve( !KU( ~aik ) @ #vk.11 )
      case Reveal_LtkTPM
      by contradiction /* from formulas */
    qed
  qed
qed

lemma injective_agree_TEE:
  all-traces
  "∀ A ga gb #i.
    ((Commit_TEE( A, ga, gb ) @ #i) ∧
     (¬(∃ #r. (RevealedTPM( A ) @ #r) ∧ (#r < #i)))) ⇒
    ((∃ #j. (Running_TPM( A, ga, gb ) @ #j) ∧ (#j < #i)) ∧
     (¬(∃ A2 #i2. (Commit_TEE( A2, ga, gb ) @ #i2) ∧ (¬(#i = #i2)))))"
/*
guarded formula characterizing all counter-examples:
"∃ A ga gb #i.
  (Commit_TEE( A, ga, gb ) @ #i)
 ∧
  (∀ #r. (RevealedTPM( A ) @ #r) ⇒ ¬(#r < #i)) ∧
  (((∀ #j. (Running_TPM( A, ga, gb ) @ #j) ⇒ ¬(#j < #i)) ∨
    (∃ A2 #i2. (Commit_TEE( A2, ga, gb ) @ #i2) ∧ ¬(#i = #i2))))"
*/
simplify
solve( (∀ #j. (Running_TPM( $A, 'g'^~ta, gb ) @ #j) ⇒ ¬(#j < #i))  ∥
       (∃ A2 #i2. (Commit_TEE( A2, 'g'^~ta, gb ) @ #i2) ∧ ¬(#i = #i2)) )
  case case_1
  solve( St_TEE( $A, ~ta, pk(x) ) ▶₀ #i )
    case TEE_send
    solve( !KU( sign(<'TPM', $A, 'g'^~ta, gb>, ~aik) ) @ #vk.6 )
      case TPM_respond
      by contradiction /* from formulas */
    next
      case c_sign
      solve( !KU( ~aik ) @ #vk.10 )
        case Reveal_LtkTPM
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case case_2
  solve( (#i < #i2)  ∥ (#i2 < #i) )
    case case_1
    solve( St_TEE( $A, ~ta, pk(x) ) ▶₀ #i )
      case TEE_send
      solve( St_TEE( $A.1, ~ta, pk(x) ) ▶₀ #i2 )
        case TEE_send
        by contradiction /* cyclic */
      qed
    qed
  next
    case case_2
    solve( St_TEE( $A, ~ta, pk(x) ) ▶₀ #i )
      case TEE_send
      solve( St_TEE( $A.1, ~ta, pk(x) ) ▶₀ #i2 )
        case TEE_send
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

lemma freshness:
  all-traces
  "∀ V A epoch n #i.
    ((AcceptedFrom( V, A, epoch, n ) @ #i) ∧
     (¬(∃ #r. (RevealedTPM( A ) @ #r) ∧ (#r < #i)))) ⇒
    (∃ #j. (SessionStart( V, A, n, epoch ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ V A epoch n #i.
  (AcceptedFrom( V, A, epoch, n ) @ #i)
 ∧
  (∀ #r. (RevealedTPM( A ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #j. (SessionStart( V, A, n, epoch ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
  case Verifier_StartSession
  by contradiction /* from formulas */
qed

lemma report_integrity:
  all-traces
  "∀ V A epoch L m #i.
    ((AcceptEntry( V, A, epoch, L, m ) @ #i) ∧
     (¬(∃ #r. (CompromisedLeaf( L ) @ #r) ∧ (#r < #i)))) ⇒
    (∃ n #j. (LeafAttested( L, A, V, epoch, n, m ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ V A epoch L m #i.
  (AcceptEntry( V, A, epoch, L, m ) @ #i)
 ∧
  (∀ #r. (CompromisedLeaf( L ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ n #j. (LeafAttested( L, A, V, epoch, n, m ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( AcceptEntry( V, A, epoch, L, m ) @ #i )
  case Verifier_AcceptAggregate_Fixed_case_1
  solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
    case Verifier_StartSession
    solve( !PkTPM( $A, pk(x) ) ▶₁ #i )
      case Register_AggrTPM
      solve( !PkLeaf( $L1, pk(x) ) ▶₂ #i )
        case Register_LeafDICE
        solve( !PkLeaf( $L2, pk(x) ) ▶₃ #i )
          case Register_LeafDICE
          solve( !PkLeaf( $L3, pk(x) ) ▶₄ #i )
            case Register_LeafDICE
            solve( !RosterOf( $A, $L1, $L2, $L3 ) ▶₅ #i )
              case Publish_Roster
              solve( !KU( sign(<'LEAF_EV', $L1, $A, $V, ~epoch, ~n, m>, ~cdi)
                     ) @ #vk.17 )
                case Leaf_Attest_case_1
                by contradiction /* from formulas */
              next
                case Leaf_Attest_case_2
                by contradiction /* from formulas */
              next
                case Leaf_Attest_case_3
                by contradiction /* from formulas */
              next
                case c_sign
                solve( !KU( ~cdi ) @ #vk.33 )
                  case Compromise_LeafSw
                  by contradiction /* from formulas */
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
next
  case Verifier_AcceptAggregate_Fixed_case_2
  solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
    case Verifier_StartSession
    solve( !PkTPM( $A, pk(x) ) ▶₁ #i )
      case Register_AggrTPM
      solve( !PkLeaf( $L1, pk(x) ) ▶₂ #i )
        case Register_LeafDICE
        solve( !PkLeaf( $L2, pk(x) ) ▶₃ #i )
          case Register_LeafDICE
          solve( !PkLeaf( $L3, pk(x) ) ▶₄ #i )
            case Register_LeafDICE
            solve( !RosterOf( $A, $L1, $L2, $L3 ) ▶₅ #i )
              case Publish_Roster
              solve( !KU( sign(<'LEAF_EV', $L1, $A, $V, ~epoch, ~n, m1>, ~cdi)
                     ) @ #vk.17 )
                case Leaf_Attest_case_1
                solve( !KU( sign(<'LEAF_EV', $L2, $A, $V, ~epoch, ~n, m.1>, ~cdi.1)
                       ) @ #vk.24 )
                  case Leaf_Attest_case_1
                  by contradiction /* from formulas */
                next
                  case Leaf_Attest_case_2
                  by contradiction /* from formulas */
                next
                  case Leaf_Attest_case_3
                  by contradiction /* from formulas */
                next
                  case c_sign
                  solve( !KU( ~cdi.1 ) @ #vk.39 )
                    case Compromise_LeafSw
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case Leaf_Attest_case_2
                by contradiction /* from formulas */
              next
                case Leaf_Attest_case_3
                by contradiction /* from formulas */
              next
                case c_sign
                solve( !KU( ~cdi ) @ #vk.33 )
                  case Compromise_LeafSw
                  solve( !KU( sign(<'LEAF_EV', $L2, $A, $V, ~epoch, ~n, m>, ~cdi.1)
                         ) @ #vk.28 )
                    case Leaf_Attest_case_1
