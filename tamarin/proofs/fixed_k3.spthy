theory HierarchicalCRA_Fixed_K3

begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Register_LeafDICE:
   [ Fr( ~cdi ) ]
  --[ EnrolledLeaf( $L, ~cdi ), OnlyOnceL( $L ) ]->
   [ !LtkLeaf( $L, ~cdi ), !PkLeaf( $L, pk(~cdi) ), Out( pk(~cdi) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_AggrTPM:
   [ Fr( ~aik ) ]
  --[ EnrolledTPM( $A, ~aik ), OnlyOnceT( $A ) ]->
   [ !LtkTPM( $A, ~aik ), !PkTPM( $A, pk(~aik) ), Out( pk(~aik) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_AggrTEE:
   [ Fr( ~tsk ) ]
  --[ EnrolledTEE( $A, ~tsk ), OnlyOnceE( $A ) ]->
   [ !LtkTEE( $A, ~tsk ), !PkTEE( $A, pk(~tsk) ), Out( pk(~tsk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Roster:
   [
   !LtkLeaf( $L1, cdi1 ), !LtkLeaf( $L2, cdi2 ), !LtkLeaf( $L3, cdi3 ),
   !LtkTPM( $A, aik )
   ]
  --[
  RosterFixed( $A, $L1, $L2, $L3 ), RosterDistinct( $L1, $L2 ),
  RosterDistinct( $L1, $L3 ), RosterDistinct( $L2, $L3 ),
  MemberOf( $L1, $A ), MemberOf( $L2, $A ), MemberOf( $L3, $A ),
  OnlyOnceR( $A )
  ]->
   [
   !RosterOf( $A, $L1, $L2, $L3 ), !Member( $L1, $A ), !Member( $L2, $A ),
   !Member( $L3, $A )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verifier_StartSession:
   [ Fr( ~n ), Fr( ~epoch ) ]
  --[ SessionStart( $V, $A, ~n, ~epoch ), UniqueEpoch( ~epoch ) ]->
   [ Out( <'CHAL', $V, $A, ~n, ~epoch> ), !Session( $V, $A, ~n, ~epoch ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) TEE_send:
   [ !LtkTEE( $A, tsk ), !PkTPM( $A, pkTpm ), Fr( ~ta ) ]
  --[ TEE_Started( $A, 'g'^~ta ) ]->
   [
   Out( <$A, 'TEE_HELLO', 'g'^~ta, sign(<'TEE', $A, 'g'^~ta>, tsk)> ),
   St_TEE( $A, ~ta, pkTpm )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) TPM_respond:
   [
   !LtkTPM( $A, aik ), !PkTEE( $A, pkTee ),
   In( <$A, 'TEE_HELLO', ga_in, sig_tee> ), Fr( ~tb )
   ]
  --[
  Eq( verify(sig_tee, <'TEE', $A, ga_in>, pkTee), true ),
  AgreeTPM( $A, ga_in, 'g'^~tb ), Running_TPM( $A, ga_in, 'g'^~tb )
  ]->
   [
   Out( <$A, 'TPM_ACK', 'g'^~tb, sign(<'TPM', $A, ga_in, 'g'^~tb>, aik)> ),
   St_TPM( $A, ~tb, ga_in )
   ]

  /*
  rule (modulo AC) TPM_respond:
     [
     !LtkTPM( $A, aik ), !PkTEE( $A, pkTee ),
     In( <$A, 'TEE_HELLO', ga_in, sig_tee> ), Fr( ~tb )
     ]
    --[
    Eq( z, true ), AgreeTPM( $A, ga_in, 'g'^~tb ),
    Running_TPM( $A, ga_in, 'g'^~tb )
    ]->
     [
     Out( <$A, 'TPM_ACK', 'g'^~tb, sign(<'TPM', $A, ga_in, 'g'^~tb>, aik)> ),
     St_TPM( $A, ~tb, ga_in )
     ]
    variants (modulo AC)
    1. $A    = $A.18
       ga_in = ga_in.21
       pkTee = pkTee.22
       sig_tee
             = sig_tee.23
       z     = verify(sig_tee.23, <'TEE', $A.18, ga_in.21>, pkTee.22)
    
    2. $A    = $A.95
       ga_in = ga_in.98
       pkTee = pk(x.188)
       sig_tee
             = sign(<'TEE', $A.95, ga_in.98>, x.188)
       z     = true
  */

rule (modulo E) TEE_finish:
   [ St_TEE( $A, ~ta, pkTpm ), In( <$A, 'TPM_ACK', gb_in, sig_tpm> ) ]
  --[
  Eq( verify(sig_tpm, <'TPM', $A, 'g'^~ta, gb_in>, pkTpm), true ),
  AgreeTEE( $A, 'g'^~ta, gb_in ), Commit_TEE( $A, 'g'^~ta, gb_in ),
  SessionKey( $A, gb_in^~ta ), SecretKey( gb_in^~ta )
  ]->
   [ !TEETPMKey( $A, gb_in^~ta ) ]

  /*
  rule (modulo AC) TEE_finish:
     [ St_TEE( $A, ~ta, pkTpm ), In( <$A, 'TPM_ACK', gb_in, sig_tpm> ) ]
    --[
    Eq( z.1, true ), AgreeTEE( $A, 'g'^~ta, gb_in ),
    Commit_TEE( $A, 'g'^~ta, gb_in ), SessionKey( $A, z ), SecretKey( z )
    ]->
     [ !TEETPMKey( $A, z ) ]
    variants (modulo AC)
     1. $A    = $A.14
        ~ta   = ~ta.15
        gb_in = gb_in.16
        pkTpm = pkTpm.17
        sig_tpm
              = sig_tpm.18
        z     = gb_in.16^~ta.15
        z.1   = verify(sig_tpm.18, <'TPM', $A.14, 'g'^~ta.15, gb_in.16>,
                       pkTpm.17)
    
     2. $A    = $A.14
        ~ta   = ~ta.15
        gb_in = DH_neutral
        pkTpm = pkTpm.17
        sig_tpm
              = sig_tpm.18
        z     = DH_neutral
        z.1   = verify(sig_tpm.18, <'TPM', $A.14, 'g'^~ta.15, DH_neutral>,
                       pkTpm.17)
    
     3. $A    = $A.16
        ~ta   = ~ta.17
        gb_in = z.22^inv(~ta.17)
        pkTpm = pkTpm.19
        sig_tpm
              = sig_tpm.20
        z     = z.22
        z.1   = verify(sig_tpm.20, <'TPM', $A.16, 'g'^~ta.17, z.22^inv(~ta.17)>,
                       pkTpm.19)
    
     4. $A    = $A.57
        ~ta   = ~ta.58
        gb_in = x.111^x.112
        pkTpm = pkTpm.60
        sig_tpm
              = sig_tpm.61
        z     = x.111^(~ta.58*x.112)
        z.1   = verify(sig_tpm.61, <'TPM', $A.57, 'g'^~ta.58, x.111^x.112>,
                       pkTpm.60)
    
     5. $A    = $A.58
        ~ta   = ~ta.59
        gb_in = DH_neutral
        pkTpm = pk(x.114)
        sig_tpm
              = sign(<'TPM', $A.58, 'g'^~ta.59, DH_neutral>, x.114)
        z     = DH_neutral
        z.1   = true
    
     6. $A    = $A.58
        ~ta   = ~ta.59
        gb_in = x.113^inv((~ta.59*x.114))
        pkTpm = pkTpm.61
        sig_tpm
              = sig_tpm.62
        z     = x.113^inv(x.114)
        z.1   = verify(sig_tpm.62,
                       <'TPM', $A.58, 'g'^~ta.59, x.113^inv((~ta.59*x.114))>, pkTpm.61)
    
     7. $A    = $A.58
        ~ta   = ~ta.59
        gb_in = x.113^(x.114*inv(~ta.59))
        pkTpm = pkTpm.61
        sig_tpm
              = sig_tpm.62
        z     = x.113^x.114
        z.1   = verify(sig_tpm.62,
                       <'TPM', $A.58, 'g'^~ta.59, x.113^(x.114*inv(~ta.59))>, pkTpm.61)
    
     8. $A    = $A.59
        ~ta   = ~ta.60
        gb_in = gb_in.61
        pkTpm = pk(x.116)
        sig_tpm
              = sign(<'TPM', $A.59, 'g'^~ta.60, gb_in.61>, x.116)
        z     = gb_in.61^~ta.60
        z.1   = true
    
     9. $A    = $A.59
        ~ta   = ~ta.60
        gb_in = z.65^inv(~ta.60)
        pkTpm = pk(x.116)
        sig_tpm
              = sign(<'TPM', $A.59, 'g'^~ta.60, z.65^inv(~ta.60)>, x.116)
        z     = z.65
        z.1   = true
    
    10. $A    = $A.59
        ~ta   = ~ta.60
        gb_in = x.114^(x.115*inv((~ta.60*x.116)))
        pkTpm = pkTpm.62
        sig_tpm
              = sig_tpm.63
        z     = x.114^(x.115*inv(x.116))
        z.1   = verify(sig_tpm.63,
                       <'TPM', $A.59, 'g'^~ta.60, x.114^(x.115*inv((~ta.60*x.116)))>, pkTpm.62)
    
    11. $A    = $A.60
        ~ta   = ~ta.61
        gb_in = x.116^x.117
        pkTpm = pk(x.118)
        sig_tpm
              = sign(<'TPM', $A.60, 'g'^~ta.61, x.116^x.117>, x.118)
        z     = x.116^(~ta.61*x.117)
        z.1   = true
    
    12. $A    = $A.60
        ~ta   = ~ta.61
        gb_in = x.116^inv((~ta.61*x.117))
        pkTpm = pk(x.118)
        sig_tpm
              = sign(<'TPM', $A.60, 'g'^~ta.61, x.116^inv((~ta.61*x.117))>, x.118)
        z     = x.116^inv(x.117)
        z.1   = true
    
    13. $A    = $A.60
        ~ta   = ~ta.61
        gb_in = x.116^(x.117*inv(~ta.61))
        pkTpm = pk(x.118)
        sig_tpm
              = sign(<'TPM', $A.60, 'g'^~ta.61, x.116^(x.117*inv(~ta.61))>, x.118)
        z     = x.116^x.117
        z.1   = true
    
    14. $A    = $A.61
        ~ta   = ~ta.62
        gb_in = x.117^(x.118*inv((~ta.62*x.119)))
        pkTpm = pk(x.120)
        sig_tpm
              = sign(<'TPM', $A.61, 'g'^~ta.62, x.117^(x.118*inv((~ta.62*x.119)))>,
                     x.120)
        z     = x.117^(x.118*inv(x.119))
        z.1   = true
  */

rule (modulo E) Leaf_Attest:
   [
   !LtkLeaf( $L, cdi ), !Member( $L, $A ), In( <'CHAL', $V, $A, n, epoch> ),
   Fr( ~m )
   ]
  --[ LeafAttested( $L, $A, $V, epoch, n, ~m ), LeafMeasurement( $L, ~m )
  ]->
   [
   Out( <'LEAF_EV', $L, $A, ~m, 
         sign(<'LEAF_EV', $L, $A, $V, epoch, n, ~m>, cdi)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Aggregator_Quote_Fixed:
   [
   !LtkTPM( $A, aik ), !TEETPMKey( $A, k ), !RosterOf( $A, $L1, $L2, $L3 ),
   In( <'CHAL', $V, $A, n, epoch> ), In( <'LEAF_EV', $L1, $A, m1, ev1> ),
   In( <'LEAF_EV', $L2, $A, m2, ev2> ), In( <'LEAF_EV', $L3, $A, m3, ev3> )
   ]
  --[ AggrQuoted( $A, $V, epoch, n, <m1, m2, m3> ), UsedKey( $A, k ) ]->
   [
   Out( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, $L3, m1, ev1, m2, ev2, m3, 
         ev3, 
         sign(<'AGG_EV', $A, $V, epoch, n, h(<m1, ev1, m2, ev2, m3, ev3>), 
               h(<$L1, $L2, $L3>)>,
              aik)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verifier_AcceptAggregate_Fixed:
   [
   !Session( $V, $A, n, epoch ), !PkTPM( $A, pkTpm ), !PkLeaf( $L1, pkL1 ),
   !PkLeaf( $L2, pkL2 ), !PkLeaf( $L3, pkL3 ),
   !RosterOf( $A, $L1, $L2, $L3 ),
   In( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, $L3, m1, ev1, m2, ev2, m3, 
        ev3, sig_agg>
   )
   ]
  --[
  Eq( verify(sig_agg,
             <'AGG_EV', $A, $V, epoch, n, h(<m1, ev1, m2, ev2, m3, ev3>), 
              h(<$L1, $L2, $L3>)>,
             pkTpm),
      true
  ),
  Eq( verify(ev1, <'LEAF_EV', $L1, $A, $V, epoch, n, m1>, pkL1), true ),
  Eq( verify(ev2, <'LEAF_EV', $L2, $A, $V, epoch, n, m2>, pkL2), true ),
  Eq( verify(ev3, <'LEAF_EV', $L3, $A, $V, epoch, n, m3>, pkL3), true ),
  Accept( $V, $A, epoch, <m1, m2, m3> ), AcceptedFrom( $V, $A, epoch, n ),
  AcceptEntry( $V, $A, epoch, $L1, m1 ),
  AcceptEntry( $V, $A, epoch, $L2, m2 ),
  AcceptEntry( $V, $A, epoch, $L3, m3 )
  ]->
   [ ]

  /*
  rule (modulo AC) Verifier_AcceptAggregate_Fixed:
     [
     !Session( $V, $A, n, epoch ), !PkTPM( $A, pkTpm ), !PkLeaf( $L1, pkL1 ),
     !PkLeaf( $L2, pkL2 ), !PkLeaf( $L3, pkL3 ),
     !RosterOf( $A, $L1, $L2, $L3 ),
     In( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, $L3, m1, ev1, m2, ev2, m3, 
          ev3, sig_agg>
     )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ), Eq( z.2, true ), Eq( z.3, true ),
    Accept( $V, $A, epoch, <m1, m2, m3> ), AcceptedFrom( $V, $A, epoch, n ),
    AcceptEntry( $V, $A, epoch, $L1, m1 ),
    AcceptEntry( $V, $A, epoch, $L2, m2 ),
    AcceptEntry( $V, $A, epoch, $L3, m3 )
    ]->
     [ ]
    variants (modulo AC)
     1. $A    = $A.25
        $L1   = $L1.26
        $L2   = $L2.27
        $L3   = $L3.28
        $V    = $V.29
        epoch = epoch.30
        ev1   = ev1.31
        ev2   = ev2.32
        ev3   = ev3.33
        m1    = m1.34
        m2    = m2.35
        m3    = m3.36
        n     = n.37
        pkL1  = pkL1.38
        pkL2  = pkL2.39
        pkL3  = pkL3.40
        pkTpm = pkTpm.41
        sig_agg
              = sig_agg.42
        z     = verify(sig_agg.42,
                       <'AGG_EV', $A.25, $V.29, epoch.30, n.37, 
                        h(<m1.34, ev1.31, m2.35, ev2.32, m3.36, ev3.33>), 
                        h(<$L1.26, $L2.27, $L3.28>)>,
                       pkTpm.41)
        z.1   = verify(ev1.31,
                       <'LEAF_EV', $L1.26, $A.25, $V.29, epoch.30, n.37, m1.34>, pkL1.38)
        z.2   = verify(ev2.32,
                       <'LEAF_EV', $L2.27, $A.25, $V.29, epoch.30, n.37, m2.35>, pkL2.39)
        z.3   = verify(ev3.33,
                       <'LEAF_EV', $L3.28, $A.25, $V.29, epoch.30, n.37, m3.36>, pkL3.40)
    
     2. $A    = $A.34
        $L1   = $L1.35
        $L2   = $L2.36
        $L3   = $L3.37
        $V    = $V.38
        epoch = epoch.39
        ev1   = sign(<'LEAF_EV', $L1.35, $A.34, $V.38, epoch.39, n.46, m1.43>,
                     x.65)
        ev2   = ev2.41
        ev3   = ev3.42
        m1    = m1.43
        m2    = m2.44
        m3    = m3.45
        n     = n.46
        pkL1  = pk(x.65)
        pkL2  = pkL2.48
        pkL3  = pkL3.49
        pkTpm = pkTpm.50
        sig_agg
              = sig_agg.51
        z     = verify(sig_agg.51,
                       <'AGG_EV', $A.34, $V.38, epoch.39, n.46, 
                        h(<m1.43, 
                           sign(<'LEAF_EV', $L1.35, $A.34, $V.38, epoch.39, n.46, m1.43>, x.65), 
                           m2.44, ev2.41, m3.45, ev3.42>), 
                        h(<$L1.35, $L2.36, $L3.37>)>,
                       pkTpm.50)
        z.1   = true
        z.2   = verify(ev2.41,
                       <'LEAF_EV', $L2.36, $A.34, $V.38, epoch.39, n.46, m2.44>, pkL2.48)
        z.3   = verify(ev3.42,
                       <'LEAF_EV', $L3.37, $A.34, $V.38, epoch.39, n.46, m3.45>, pkL3.49)
    
     3. $A    = $A.35
        $L1   = $L1.36
        $L2   = $L2.37
        $L3   = $L3.38
        $V    = $V.39
        epoch = epoch.40
        ev1   = ev1.41
        ev2   = sign(<'LEAF_EV', $L2.37, $A.35, $V.39, epoch.40, n.47, m2.45>,
                     x.67)
        ev3   = ev3.43
        m1    = m1.44
        m2    = m2.45
        m3    = m3.46
        n     = n.47
        pkL1  = pkL1.48
        pkL2  = pk(x.67)
        pkL3  = pkL3.50
        pkTpm = pkTpm.51
        sig_agg
              = sig_agg.52
        z     = verify(sig_agg.52,
                       <'AGG_EV', $A.35, $V.39, epoch.40, n.47, 
                        h(<m1.44, ev1.41, m2.45, 
                           sign(<'LEAF_EV', $L2.37, $A.35, $V.39, epoch.40, n.47, m2.45>, x.67), 
                           m3.46, ev3.43>), 
                        h(<$L1.36, $L2.37, $L3.38>)>,
                       pkTpm.51)
        z.1   = verify(ev1.41,
                       <'LEAF_EV', $L1.36, $A.35, $V.39, epoch.40, n.47, m1.44>, pkL1.48)
        z.2   = true
        z.3   = verify(ev3.43,
                       <'LEAF_EV', $L3.38, $A.35, $V.39, epoch.40, n.47, m3.46>, pkL3.50)
    
     4. $A    = $A.36
        $L1   = $L1.37
        $L2   = $L2.38
        $L3   = $L3.39
        $V    = $V.40
        epoch = epoch.41
        ev1   = ev1.42
        ev2   = ev2.43
        ev3   = sign(<'LEAF_EV', $L3.39, $A.36, $V.40, epoch.41, n.48, m3.47>,
                     x.69)
        m1    = m1.45
        m2    = m2.46
        m3    = m3.47
        n     = n.48
        pkL1  = pkL1.49
        pkL2  = pkL2.50
        pkL3  = pk(x.69)
        pkTpm = pkTpm.52
        sig_agg
              = sig_agg.53
        z     = verify(sig_agg.53,
                       <'AGG_EV', $A.36, $V.40, epoch.41, n.48, 
                        h(<m1.45, ev1.42, m2.46, ev2.43, m3.47, 
                           sign(<'LEAF_EV', $L3.39, $A.36, $V.40, epoch.41, n.48, m3.47>, x.69)>), 
                        h(<$L1.37, $L2.38, $L3.39>)>,
                       pkTpm.52)
        z.1   = verify(ev1.42,
                       <'LEAF_EV', $L1.37, $A.36, $V.40, epoch.41, n.48, m1.45>, pkL1.49)
        z.2   = verify(ev2.43,
                       <'LEAF_EV', $L2.38, $A.36, $V.40, epoch.41, n.48, m2.46>, pkL2.50)
        z.3   = true
    
     5. $A    = $A.36
        $L1   = $L1.37
        $L2   = $L2.38
        $L3   = $L3.39
        $V    = $V.40
        epoch = epoch.41
        ev1   = sign(<'LEAF_EV', $L1.37, $A.36, $V.40, epoch.41, n.48, m1.45>,
                     x.67)
        ev2   = sign(<'LEAF_EV', $L2.38, $A.36, $V.40, epoch.41, n.48, m2.46>,
                     x.69)
        ev3   = ev3.44
        m1    = m1.45
        m2    = m2.46
        m3    = m3.47
        n     = n.48
        pkL1  = pk(x.67)
        pkL2  = pk(x.69)
        pkL3  = pkL3.51
        pkTpm = pkTpm.52
        sig_agg
              = sig_agg.53
        z     = verify(sig_agg.53,
                       <'AGG_EV', $A.36, $V.40, epoch.41, n.48, 
                        h(<m1.45, 
                           sign(<'LEAF_EV', $L1.37, $A.36, $V.40, epoch.41, n.48, m1.45>, x.67), 
                           m2.46, 
                           sign(<'LEAF_EV', $L2.38, $A.36, $V.40, epoch.41, n.48, m2.46>, x.69), 
                           m3.47, ev3.44>), 
                        h(<$L1.37, $L2.38, $L3.39>)>,
                       pkTpm.52)
        z.1   = true
        z.2   = true
        z.3   = verify(ev3.44,
                       <'LEAF_EV', $L3.39, $A.36, $V.40, epoch.41, n.48, m3.47>, pkL3.51)
    
     6. $A    = $A.37
        $L1   = $L1.38
        $L2   = $L2.39
        $L3   = $L3.40
        $V    = $V.41
        epoch = epoch.42
        ev1   = ev1.43
        ev2   = sign(<'LEAF_EV', $L2.39, $A.37, $V.41, epoch.42, n.49, m2.47>,
                     x.69)
        ev3   = sign(<'LEAF_EV', $L3.40, $A.37, $V.41, epoch.42, n.49, m3.48>,
