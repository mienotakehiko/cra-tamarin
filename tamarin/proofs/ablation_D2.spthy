"∃ V A epoch evset L #i #j.
  (Accept( V, A, epoch, evset ) @ #i) ∧ (MemberOf( L, A ) @ #j)
 ∧
  (#j < #i) ∧
  (∀ #r. (CompromisedLeaf( L ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevealedTPM( A ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ m #k.
    (AcceptEntry( V, A, epoch, L, m ) @ #k) ⇒ (¬(#k < #i)) ∧ (¬(#k = #i)))"
*/
simplify
solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
  case Verifier_StartSession
  solve( !PkTPM( $A, pk(x) ) ▶₁ #i )
    case Register_AggrTPM
    solve( !PkLeaf( $L1, pk(x) ) ▶₂ #i )
      case Register_LeafDICE
      solve( !PkLeaf( $L2, pk(x) ) ▶₃ #i )
        case Register_LeafDICE
        solve( !RosterOf( $A, $L1, $L2 ) ▶₄ #i )
          case Publish_Roster
          solve( MemberOf( L, $A ) @ #j )
            case Publish_Roster_case_1
            by contradiction /* from formulas */
          next
            case Publish_Roster_case_2
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

