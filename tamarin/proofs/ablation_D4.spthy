theory HierarchicalCRA_Ablation_D4

begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Register_LeafDICE:
   [ Fr( ~cdi ) ]
  --[ EnrolledLeaf( $L, ~cdi ), OnlyOnceL( $L ) ]->
   [ !LtkLeaf( $L, ~cdi ), !PkLeaf( $L, pk(~cdi) ), Out( pk(~cdi) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_AggrTPM:
   [ Fr( ~aik ) ]
  --[ EnrolledTPM( $A, ~aik ), OnlyOnceT( $A ) ]->
   [ !LtkTPM( $A, ~aik ), !PkTPM( $A, pk(~aik) ), Out( pk(~aik) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_AggrTEE:
   [ Fr( ~tsk ) ]
  --[ EnrolledTEE( $A, ~tsk ), OnlyOnceE( $A ) ]->
   [ !LtkTEE( $A, ~tsk ), !PkTEE( $A, pk(~tsk) ), Out( pk(~tsk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Publish_Roster:
   [ !LtkLeaf( $L1, cdi1 ), !LtkLeaf( $L2, cdi2 ), !LtkTPM( $A, aik ) ]
  --[
  RosterFixed( $A, $L1, $L2 ), RosterDistinct( $L1, $L2 ),
  MemberOf( $L1, $A ), MemberOf( $L2, $A ), OnlyOnceR( $A )
  ]->
   [ !RosterOf( $A, $L1, $L2 ), !Member( $L1, $A ), !Member( $L2, $A ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verifier_StartSession:
   [ Fr( ~n ), Fr( ~epoch ) ]
  --[ SessionStart( $V, $A, ~n, ~epoch ), UniqueEpoch( ~epoch ) ]->
   [ Out( <'CHAL', $V, $A, ~n, ~epoch> ), !Session( $V, $A, ~n, ~epoch ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) TEE_send:
   [ !LtkTEE( $A, tsk ), !PkTPM( $A, pkTpm ), Fr( ~ta ) ]
  --[ TEE_Started( $A, 'g'^~ta ) ]->
   [
   Out( <$A, 'TEE_HELLO', 'g'^~ta, sign(<'TEE', $A, 'g'^~ta>, tsk)> ),
   St_TEE( $A, ~ta, pkTpm )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) TPM_respond:
   [
   !LtkTPM( $A, aik ), !PkTEE( $A, pkTee ),
   In( <$A, 'TEE_HELLO', ga_in, sig_tee> ), Fr( ~tb )
   ]
  --[
  Eq( verify(sig_tee, <'TEE', $A, ga_in>, pkTee), true ),
  AgreeTPM( $A, ga_in, 'g'^~tb ), Running_TPM( $A, ga_in, 'g'^~tb )
  ]->
   [
   Out( <$A, 'TPM_ACK', 'g'^~tb, sign(<'TPM', $A, ga_in, 'g'^~tb>, aik)> ),
   St_TPM( $A, ~tb, ga_in )
   ]

  /*
  rule (modulo AC) TPM_respond:
     [
     !LtkTPM( $A, aik ), !PkTEE( $A, pkTee ),
     In( <$A, 'TEE_HELLO', ga_in, sig_tee> ), Fr( ~tb )
     ]
    --[
    Eq( z, true ), AgreeTPM( $A, ga_in, 'g'^~tb ),
    Running_TPM( $A, ga_in, 'g'^~tb )
    ]->
     [
     Out( <$A, 'TPM_ACK', 'g'^~tb, sign(<'TPM', $A, ga_in, 'g'^~tb>, aik)> ),
     St_TPM( $A, ~tb, ga_in )
     ]
    variants (modulo AC)
    1. $A    = $A.18
       ga_in = ga_in.21
       pkTee = pkTee.22
       sig_tee
             = sig_tee.23
       z     = verify(sig_tee.23, <'TEE', $A.18, ga_in.21>, pkTee.22)
    
    2. $A    = $A.95
       ga_in = ga_in.98
       pkTee = pk(x.188)
       sig_tee
             = sign(<'TEE', $A.95, ga_in.98>, x.188)
       z     = true
  */

rule (modulo E) TEE_finish:
   [ St_TEE( $A, ~ta, pkTpm ), In( <$A, 'TPM_ACK', gb_in, sig_tpm> ) ]
  --[
  Eq( verify(sig_tpm, <'TPM', $A, 'g'^~ta, gb_in>, pkTpm), true ),
  AgreeTEE( $A, 'g'^~ta, gb_in ), Commit_TEE( $A, 'g'^~ta, gb_in ),
  SessionKey( $A, gb_in^~ta ), SecretKey( gb_in^~ta )
  ]->
   [ !TEETPMKey( $A, gb_in^~ta ) ]

  /*
  rule (modulo AC) TEE_finish:
     [ St_TEE( $A, ~ta, pkTpm ), In( <$A, 'TPM_ACK', gb_in, sig_tpm> ) ]
    --[
    Eq( z.1, true ), AgreeTEE( $A, 'g'^~ta, gb_in ),
    Commit_TEE( $A, 'g'^~ta, gb_in ), SessionKey( $A, z ), SecretKey( z )
    ]->
     [ !TEETPMKey( $A, z ) ]
    variants (modulo AC)
     1. $A    = $A.14
        ~ta   = ~ta.15
        gb_in = gb_in.16
        pkTpm = pkTpm.17
        sig_tpm
              = sig_tpm.18
        z     = gb_in.16^~ta.15
        z.1   = verify(sig_tpm.18, <'TPM', $A.14, 'g'^~ta.15, gb_in.16>,
                       pkTpm.17)
    
     2. $A    = $A.14
        ~ta   = ~ta.15
        gb_in = DH_neutral
        pkTpm = pkTpm.17
        sig_tpm
              = sig_tpm.18
        z     = DH_neutral
        z.1   = verify(sig_tpm.18, <'TPM', $A.14, 'g'^~ta.15, DH_neutral>,
                       pkTpm.17)
    
     3. $A    = $A.16
        ~ta   = ~ta.17
        gb_in = z.22^inv(~ta.17)
        pkTpm = pkTpm.19
        sig_tpm
              = sig_tpm.20
        z     = z.22
        z.1   = verify(sig_tpm.20, <'TPM', $A.16, 'g'^~ta.17, z.22^inv(~ta.17)>,
                       pkTpm.19)
    
     4. $A    = $A.57
        ~ta   = ~ta.58
        gb_in = x.111^x.112
        pkTpm = pkTpm.60
        sig_tpm
              = sig_tpm.61
        z     = x.111^(~ta.58*x.112)
        z.1   = verify(sig_tpm.61, <'TPM', $A.57, 'g'^~ta.58, x.111^x.112>,
                       pkTpm.60)
    
     5. $A    = $A.58
        ~ta   = ~ta.59
        gb_in = DH_neutral
        pkTpm = pk(x.114)
        sig_tpm
              = sign(<'TPM', $A.58, 'g'^~ta.59, DH_neutral>, x.114)
        z     = DH_neutral
        z.1   = true
    
     6. $A    = $A.58
        ~ta   = ~ta.59
        gb_in = x.113^inv((~ta.59*x.114))
        pkTpm = pkTpm.61
        sig_tpm
              = sig_tpm.62
        z     = x.113^inv(x.114)
        z.1   = verify(sig_tpm.62,
                       <'TPM', $A.58, 'g'^~ta.59, x.113^inv((~ta.59*x.114))>, pkTpm.61)
    
     7. $A    = $A.58
        ~ta   = ~ta.59
        gb_in = x.113^(x.114*inv(~ta.59))
        pkTpm = pkTpm.61
        sig_tpm
              = sig_tpm.62
        z     = x.113^x.114
        z.1   = verify(sig_tpm.62,
                       <'TPM', $A.58, 'g'^~ta.59, x.113^(x.114*inv(~ta.59))>, pkTpm.61)
    
     8. $A    = $A.59
        ~ta   = ~ta.60
        gb_in = gb_in.61
        pkTpm = pk(x.116)
        sig_tpm
              = sign(<'TPM', $A.59, 'g'^~ta.60, gb_in.61>, x.116)
        z     = gb_in.61^~ta.60
        z.1   = true
    
     9. $A    = $A.59
        ~ta   = ~ta.60
        gb_in = z.65^inv(~ta.60)
        pkTpm = pk(x.116)
        sig_tpm
              = sign(<'TPM', $A.59, 'g'^~ta.60, z.65^inv(~ta.60)>, x.116)
        z     = z.65
        z.1   = true
    
    10. $A    = $A.59
        ~ta   = ~ta.60
        gb_in = x.114^(x.115*inv((~ta.60*x.116)))
        pkTpm = pkTpm.62
        sig_tpm
              = sig_tpm.63
        z     = x.114^(x.115*inv(x.116))
        z.1   = verify(sig_tpm.63,
                       <'TPM', $A.59, 'g'^~ta.60, x.114^(x.115*inv((~ta.60*x.116)))>, pkTpm.62)
    
    11. $A    = $A.60
        ~ta   = ~ta.61
        gb_in = x.116^x.117
        pkTpm = pk(x.118)
        sig_tpm
              = sign(<'TPM', $A.60, 'g'^~ta.61, x.116^x.117>, x.118)
        z     = x.116^(~ta.61*x.117)
        z.1   = true
    
    12. $A    = $A.60
        ~ta   = ~ta.61
        gb_in = x.116^inv((~ta.61*x.117))
        pkTpm = pk(x.118)
        sig_tpm
              = sign(<'TPM', $A.60, 'g'^~ta.61, x.116^inv((~ta.61*x.117))>, x.118)
        z     = x.116^inv(x.117)
        z.1   = true
    
    13. $A    = $A.60
        ~ta   = ~ta.61
        gb_in = x.116^(x.117*inv(~ta.61))
        pkTpm = pk(x.118)
        sig_tpm
              = sign(<'TPM', $A.60, 'g'^~ta.61, x.116^(x.117*inv(~ta.61))>, x.118)
        z     = x.116^x.117
        z.1   = true
    
    14. $A    = $A.61
        ~ta   = ~ta.62
        gb_in = x.117^(x.118*inv((~ta.62*x.119)))
        pkTpm = pk(x.120)
        sig_tpm
              = sign(<'TPM', $A.61, 'g'^~ta.62, x.117^(x.118*inv((~ta.62*x.119)))>,
                     x.120)
        z     = x.117^(x.118*inv(x.119))
        z.1   = true
  */

rule (modulo E) Leaf_Attest:
   [
   !LtkLeaf( $L, cdi ), !Member( $L, $A ), In( <'CHAL', $V, $A, n, epoch> ),
   Fr( ~m )
   ]
  --[ LeafAttested( $L, $A, $V, epoch, n, ~m ), LeafMeasurement( $L, ~m )
  ]->
   [
   Out( <'LEAF_EV', $L, $A, ~m, 
         sign(<'LEAF_EV', $L, $A, $V, epoch, n, ~m>, cdi)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Aggregator_Quote_Fixed:
   [
   !LtkTPM( $A, aik ), !TEETPMKey( $A, k ), !RosterOf( $A, $L1, $L2 ),
   In( <'CHAL', $V, $A, n, epoch> ), In( <'LEAF_EV', $L1, $A, m1, ev1> ),
   In( <'LEAF_EV', $L2, $A, m2, ev2> )
   ]
  --[ AggrQuoted( $A, $V, epoch, n, <m1, m2> ), UsedKey( $A, k ) ]->
   [
   Out( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, m1, ev1, m2, ev2, 
         sign(<'AGG_EV', $A, $V, epoch, n, h(<m1, ev1, m2, ev2>), h(<$L1, $L2>)>,
              aik)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verifier_AcceptAggregate_NA:
   [
   !Session( $V, $A, n, epoch ), !PkTPM( $A, pkTpm ),
   !RosterOf( $A, $L1, $L2 ),
   In( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, m1, ev1, m2, ev2, sig_agg> )
   ]
  --[
  Eq( verify(sig_agg,
             <'AGG_EV', $A, $V, epoch, n, h(<m1, ev1, m2, ev2>), h(<$L1, $L2>)>,
             pkTpm),
      true
  ),
  Accept( $V, $A, epoch, <m1, m2> ), AcceptedFrom( $V, $A, epoch, n )
  ]->
   [ ]

  /*
  rule (modulo AC) Verifier_AcceptAggregate_NA:
     [
     !Session( $V, $A, n, epoch ), !PkTPM( $A, pkTpm ),
     !RosterOf( $A, $L1, $L2 ),
     In( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, m1, ev1, m2, ev2, sig_agg> )
     ]
    --[
    Eq( z, true ), Accept( $V, $A, epoch, <m1, m2> ),
    AcceptedFrom( $V, $A, epoch, n )
    ]->
     [ ]
    variants (modulo AC)
    1. $A    = $A.16
       $L1   = $L1.17
       $L2   = $L2.18
       $V    = $V.19
       epoch = epoch.20
       ev1   = ev1.21
       ev2   = ev2.22
       m1    = m1.23
       m2    = m2.24
       n     = n.25
       pkTpm = pkTpm.26
       sig_agg
             = sig_agg.27
       z     = verify(sig_agg.27,
                      <'AGG_EV', $A.16, $V.19, epoch.20, n.25, 
                       h(<m1.23, ev1.21, m2.24, ev2.22>), h(<$L1.17, $L2.18>)>,
                      pkTpm.26)
    
    2. $A    = $A.26
       $L1   = $L1.27
       $L2   = $L2.28
       $V    = $V.29
       epoch = epoch.30
       ev1   = ev1.31
       ev2   = ev2.32
       m1    = m1.33
       m2    = m2.34
       n     = n.35
       pkTpm = pk(x.50)
       sig_agg
             = sign(<'AGG_EV', $A.26, $V.29, epoch.30, n.35, 
                     h(<m1.33, ev1.31, m2.34, ev2.32>), h(<$L1.27, $L2.28>)>,
                    x.50)
       z     = true
  */

rule (modulo E) Verifier_ParseEntry_L1:
   [
   !Session( $V, $A, n, epoch ), !PkTPM( $A, pkTpm ), !PkLeaf( $L1, pkL1 ),
   !RosterOf( $A, $L1, $L2 ),
   In( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, m1, ev1, m2, ev2, sig_agg> )
   ]
  --[
  Eq( verify(sig_agg,
             <'AGG_EV', $A, $V, epoch, n, h(<m1, ev1, m2, ev2>), h(<$L1, $L2>)>,
             pkTpm),
      true
  ),
  Eq( verify(ev1, <'LEAF_EV', $L1, $A, $V, epoch, n, m1>, pkL1), true ),
  AcceptEntry( $V, $A, epoch, $L1, m1 )
  ]->
   [ ]

  /*
  rule (modulo AC) Verifier_ParseEntry_L1:
     [
     !Session( $V, $A, n, epoch ), !PkTPM( $A, pkTpm ), !PkLeaf( $L1, pkL1 ),
     !RosterOf( $A, $L1, $L2 ),
     In( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, m1, ev1, m2, ev2, sig_agg> )
     ]
    --[ Eq( z, true ), Eq( z.1, true ), AcceptEntry( $V, $A, epoch, $L1, m1 )
    ]->
     [ ]
    variants (modulo AC)
    1. $A    = $A.18
       $L1   = $L1.19
       $L2   = $L2.20
       $V    = $V.21
       epoch = epoch.22
       ev1   = ev1.23
       ev2   = ev2.24
       m1    = m1.25
       m2    = m2.26
       n     = n.27
       pkL1  = pkL1.28
       pkTpm = pkTpm.29
       sig_agg
             = sig_agg.30
       z     = verify(sig_agg.30,
                      <'AGG_EV', $A.18, $V.21, epoch.22, n.27, 
                       h(<m1.25, ev1.23, m2.26, ev2.24>), h(<$L1.19, $L2.20>)>,
                      pkTpm.29)
       z.1   = verify(ev1.23,
                      <'LEAF_EV', $L1.19, $A.18, $V.21, epoch.22, n.27, m1.25>, pkL1.28)
    
    2. $A    = $A.26
       $L1   = $L1.27
       $L2   = $L2.28
       $V    = $V.29
       epoch = epoch.30
       ev1   = sign(<'LEAF_EV', $L1.27, $A.26, $V.29, epoch.30, n.35, m1.33>,
                    x.49)
       ev2   = ev2.32
       m1    = m1.33
       m2    = m2.34
       n     = n.35
       pkL1  = pk(x.49)
       pkTpm = pkTpm.37
       sig_agg
             = sig_agg.38
       z     = verify(sig_agg.38,
                      <'AGG_EV', $A.26, $V.29, epoch.30, n.35, 
                       h(<m1.33, 
                          sign(<'LEAF_EV', $L1.27, $A.26, $V.29, epoch.30, n.35, m1.33>, x.49), 
                          m2.34, ev2.32>), 
                       h(<$L1.27, $L2.28>)>,
                      pkTpm.37)
       z.1   = true
    
    3. $A    = $A.28
       $L1   = $L1.29
       $L2   = $L2.30
       $V    = $V.31
       epoch = epoch.32
       ev1   = sign(<'LEAF_EV', $L1.29, $A.28, $V.31, epoch.32, n.37, m1.35>,
                    x.51)
       ev2   = ev2.34
       m1    = m1.35
       m2    = m2.36
       n     = n.37
       pkL1  = pk(x.51)
       pkTpm = pk(x.54)
       sig_agg
             = sign(<'AGG_EV', $A.28, $V.31, epoch.32, n.37, 
                     h(<m1.35, 
                        sign(<'LEAF_EV', $L1.29, $A.28, $V.31, epoch.32, n.37, m1.35>, x.51), 
                        m2.36, ev2.34>), 
                     h(<$L1.29, $L2.30>)>,
                    x.54)
       z     = true
       z.1   = true
    
    4. $A    = $A.30
       $L1   = $L1.31
       $L2   = $L2.32
       $V    = $V.33
       epoch = epoch.34
       ev1   = ev1.35
       ev2   = ev2.36
       m1    = m1.37
       m2    = m2.38
       n     = n.39
       pkL1  = pkL1.40
       pkTpm = pk(x.57)
       sig_agg
             = sign(<'AGG_EV', $A.30, $V.33, epoch.34, n.39, 
                     h(<m1.37, ev1.35, m2.38, ev2.36>), h(<$L1.31, $L2.32>)>,
                    x.57)
       z     = true
       z.1   = verify(ev1.35,
                      <'LEAF_EV', $L1.31, $A.30, $V.33, epoch.34, n.39, m1.37>, pkL1.40)
  */

rule (modulo E) Verifier_ParseEntry_L2:
   [
   !Session( $V, $A, n, epoch ), !PkTPM( $A, pkTpm ), !PkLeaf( $L2, pkL2 ),
   !RosterOf( $A, $L1, $L2 ),
   In( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, m1, ev1, m2, ev2, sig_agg> )
   ]
  --[
  Eq( verify(sig_agg,
             <'AGG_EV', $A, $V, epoch, n, h(<m1, ev1, m2, ev2>), h(<$L1, $L2>)>,
             pkTpm),
      true
  ),
  Eq( verify(ev2, <'LEAF_EV', $L2, $A, $V, epoch, n, m2>, pkL2), true ),
  AcceptEntry( $V, $A, epoch, $L2, m2 )
  ]->
   [ ]

  /*
  rule (modulo AC) Verifier_ParseEntry_L2:
     [
     !Session( $V, $A, n, epoch ), !PkTPM( $A, pkTpm ), !PkLeaf( $L2, pkL2 ),
     !RosterOf( $A, $L1, $L2 ),
     In( <'AGG_REPORT', $A, $V, epoch, $L1, $L2, m1, ev1, m2, ev2, sig_agg> )
     ]
    --[ Eq( z, true ), Eq( z.1, true ), AcceptEntry( $V, $A, epoch, $L2, m2 )
    ]->
     [ ]
    variants (modulo AC)
    1. $A    = $A.18
       $L1   = $L1.19
       $L2   = $L2.20
       $V    = $V.21
       epoch = epoch.22
       ev1   = ev1.23
       ev2   = ev2.24
       m1    = m1.25
       m2    = m2.26
       n     = n.27
       pkL2  = pkL2.28
       pkTpm = pkTpm.29
       sig_agg
             = sig_agg.30
       z     = verify(sig_agg.30,
                      <'AGG_EV', $A.18, $V.21, epoch.22, n.27, 
                       h(<m1.25, ev1.23, m2.26, ev2.24>), h(<$L1.19, $L2.20>)>,
                      pkTpm.29)
       z.1   = verify(ev2.24,
                      <'LEAF_EV', $L2.20, $A.18, $V.21, epoch.22, n.27, m2.26>, pkL2.28)
    
    2. $A    = $A.27
       $L1   = $L1.28
       $L2   = $L2.29
       $V    = $V.30
       epoch = epoch.31
       ev1   = ev1.32
       ev2   = sign(<'LEAF_EV', $L2.29, $A.27, $V.30, epoch.31, n.36, m2.35>,
                    x.51)
       m1    = m1.34
       m2    = m2.35
       n     = n.36
       pkL2  = pk(x.51)
       pkTpm = pkTpm.38
       sig_agg
             = sig_agg.39
       z     = verify(sig_agg.39,
                      <'AGG_EV', $A.27, $V.30, epoch.31, n.36, 
                       h(<m1.34, ev1.32, m2.35, 
                          sign(<'LEAF_EV', $L2.29, $A.27, $V.30, epoch.31, n.36, m2.35>, x.51)>), 
                       h(<$L1.28, $L2.29>)>,
                      pkTpm.38)
       z.1   = true
    
    3. $A    = $A.28
       $L1   = $L1.29
       $L2   = $L2.30
       $V    = $V.31
       epoch = epoch.32
       ev1   = ev1.33
       ev2   = sign(<'LEAF_EV', $L2.30, $A.28, $V.31, epoch.32, n.37, m2.36>,
                    x.52)
       m1    = m1.35
       m2    = m2.36
       n     = n.37
       pkL2  = pk(x.52)
       pkTpm = pk(x.54)
       sig_agg
             = sign(<'AGG_EV', $A.28, $V.31, epoch.32, n.37, 
                     h(<m1.35, ev1.33, m2.36, 
                        sign(<'LEAF_EV', $L2.30, $A.28, $V.31, epoch.32, n.37, m2.36>, x.52)>), 
                     h(<$L1.29, $L2.30>)>,
                    x.54)
       z     = true
       z.1   = true
    
    4. $A    = $A.30
       $L1   = $L1.31
       $L2   = $L2.32
       $V    = $V.33
       epoch = epoch.34
       ev1   = ev1.35
       ev2   = ev2.36
       m1    = m1.37
       m2    = m2.38
       n     = n.39
       pkL2  = pkL2.40
       pkTpm = pk(x.57)
       sig_agg
             = sign(<'AGG_EV', $A.30, $V.33, epoch.34, n.39, 
                     h(<m1.37, ev1.35, m2.38, ev2.36>), h(<$L1.31, $L2.32>)>,
                    x.57)
       z     = true
       z.1   = verify(ev2.36,
                      <'LEAF_EV', $L2.32, $A.30, $V.33, epoch.34, n.39, m2.38>, pkL2.40)
  */

rule (modulo E) Reveal_LtkTPM:
   [ !LtkTPM( $A, aik ) ] --[ RevealedTPM( $A ) ]-> [ Out( aik ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_LtkTEE:
   [ !LtkTEE( $A, tsk ) ] --[ RevealedTEE( $A ) ]-> [ Out( tsk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromise_LeafSw:
   [ !LtkLeaf( $L, cdi ) ] --[ CompromisedLeaf( $L ) ]-> [ Out( cdi ) ]

  /* has exactly the trivial AC variant */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction Unique_LeafEnrollment:
  "∀ L #i #j. ((OnlyOnceL( L ) @ #i) ∧ (OnlyOnceL( L ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ L #i #j. ((OnlyOnceL( L ) @ #i) ∧ (OnlyOnceL( L ) @ #j)) ⇒ (#i = #j)"
  */

restriction Unique_TPMEnrollment:
  "∀ A #i #j. ((OnlyOnceT( A ) @ #i) ∧ (OnlyOnceT( A ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A #i #j. ((OnlyOnceT( A ) @ #i) ∧ (OnlyOnceT( A ) @ #j)) ⇒ (#i = #j)"
  */

restriction Unique_TEEEnrollment:
  "∀ A #i #j. ((OnlyOnceE( A ) @ #i) ∧ (OnlyOnceE( A ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A #i #j. ((OnlyOnceE( A ) @ #i) ∧ (OnlyOnceE( A ) @ #j)) ⇒ (#i = #j)"
  */

restriction Roster_Distinct:
  "∀ x #i. (RosterDistinct( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (RosterDistinct( x, x ) @ #i) ⇒ (⊥)"
  */

restriction Unique_Roster:
  "∀ A #i #j. ((OnlyOnceR( A ) @ #i) ∧ (OnlyOnceR( A ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ A #i #j. ((OnlyOnceR( A ) @ #i) ∧ (OnlyOnceR( A ) @ #j)) ⇒ (#i = #j)"
  */

restriction Unique_Epoch:
  "∀ e #i #j.
    ((UniqueEpoch( e ) @ #i) ∧ (UniqueEpoch( e ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ e #i #j.
    ((UniqueEpoch( e ) @ #i) ∧ (UniqueEpoch( e ) @ #j)) ⇒ (#i = #j)"
  */

lemma executability:
  exists-trace
  "∃ V A epoch evset #i.
    (((Accept( V, A, epoch, evset ) @ #i) ∧
      (¬(∃ X #j. RevealedTPM( X ) @ #j))) ∧
     (¬(∃ X #j. RevealedTEE( X ) @ #j))) ∧
    (¬(∃ X #j. CompromisedLeaf( X ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ V A epoch evset #i.
  (Accept( V, A, epoch, evset ) @ #i)
 ∧
  (∀ X #j. (RevealedTPM( X ) @ #j) ⇒ ⊥) ∧
  (∀ X #j. (RevealedTEE( X ) @ #j) ⇒ ⊥) ∧
  (∀ X #j. (CompromisedLeaf( X ) @ #j) ⇒ ⊥)"
*/
simplify
solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
  case Verifier_StartSession
  solve( !PkTPM( $A, pk(x) ) ▶₁ #i )
    case Register_AggrTPM
    solve( !RosterOf( $A, $L1, $L2 ) ▶₂ #i )
      case Publish_Roster
      solve( !KU( sign(<'AGG_EV', $A, $V, ~epoch, ~n, h(<m1, ev1, m2, ev2>), 
                        h(<$L1, $L2>)>,
                       ~aik)
             ) @ #vk.20 )
        case Aggregator_Quote_Fixed
        solve( !KU( sign(<'TPM', $A, 'g'^~ta, gb_in>, ~aik) ) @ #vk.41 )
          case TPM_respond
          solve( !KU( ~epoch ) @ #vk.23 )
            case Verifier_StartSession
            solve( !KU( ~n ) @ #vk.39 )
              case Verifier_StartSession
              solve( !KU( sign(<'TEE', $A, 'g'^~ta>, ~tsk) ) @ #vk.47 )
                case TEE_send
                solve( !KU( 'g'^~ta ) @ #vk.47 )
                  case TEE_send
                  solve( !KU( 'g'^~tb ) @ #vk.46 )
                    case TPM_respond
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma key_secrecy:
  all-traces
  "∀ A k #i.
    (((SessionKey( A, k ) @ #i) ∧ (¬(∃ #j. RevealedTPM( A ) @ #j))) ∧
     (¬(∃ #j. RevealedTEE( A ) @ #j))) ⇒
    (¬(∃ #m. K( k ) @ #m))"
/*
guarded formula characterizing all counter-examples:
"∃ A k #i.
  (SessionKey( A, k ) @ #i)
 ∧
  (∀ #j. (RevealedTPM( A ) @ #j) ⇒ ⊥) ∧
  (∀ #j. (RevealedTEE( A ) @ #j) ⇒ ⊥) ∧
  (∃ #m. (K( k ) @ #m))"
*/
simplify
solve( St_TEE( $A, ~ta, pk(x) ) ▶₀ #i )
  case TEE_send
  solve( !KU( sign(<'TPM', $A, 'g'^~ta, gb_in>, ~aik) ) @ #vk.6 )
    case TPM_respond
    solve( !KU( 'g'^(~ta*~tb) ) @ #vk.8 )
      case TEE_send
      by solve( !KU( ~tb ) @ #vk.14 )
    next
      case TPM_respond
      by solve( !KU( ~ta ) @ #vk.14 )
    next
      case c_exp
      by solve( !KU( ~ta ) @ #vk.16 )
    qed
  next
    case c_sign
    solve( !KU( ~aik ) @ #vk.11 )
      case Reveal_LtkTPM
      by contradiction /* from formulas */
    qed
  qed
qed

lemma injective_agree_TEE:
  all-traces
  "∀ A ga gb #i.
    ((Commit_TEE( A, ga, gb ) @ #i) ∧
     (¬(∃ #r. (RevealedTPM( A ) @ #r) ∧ (#r < #i)))) ⇒
    ((∃ #j. (Running_TPM( A, ga, gb ) @ #j) ∧ (#j < #i)) ∧
     (¬(∃ A2 #i2. (Commit_TEE( A2, ga, gb ) @ #i2) ∧ (¬(#i = #i2)))))"
/*
guarded formula characterizing all counter-examples:
"∃ A ga gb #i.
  (Commit_TEE( A, ga, gb ) @ #i)
 ∧
  (∀ #r. (RevealedTPM( A ) @ #r) ⇒ ¬(#r < #i)) ∧
  (((∀ #j. (Running_TPM( A, ga, gb ) @ #j) ⇒ ¬(#j < #i)) ∨
    (∃ A2 #i2. (Commit_TEE( A2, ga, gb ) @ #i2) ∧ ¬(#i = #i2))))"
*/
simplify
solve( (∀ #j. (Running_TPM( $A, 'g'^~ta, gb ) @ #j) ⇒ ¬(#j < #i))  ∥
       (∃ A2 #i2. (Commit_TEE( A2, 'g'^~ta, gb ) @ #i2) ∧ ¬(#i = #i2)) )
  case case_1
  solve( St_TEE( $A, ~ta, pk(x) ) ▶₀ #i )
    case TEE_send
    solve( !KU( sign(<'TPM', $A, 'g'^~ta, gb>, ~aik) ) @ #vk.6 )
      case TPM_respond
      by contradiction /* from formulas */
    next
      case c_sign
      solve( !KU( ~aik ) @ #vk.10 )
        case Reveal_LtkTPM
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case case_2
  solve( (#i < #i2)  ∥ (#i2 < #i) )
    case case_1
    solve( St_TEE( $A, ~ta, pk(x) ) ▶₀ #i )
      case TEE_send
      solve( St_TEE( $A.1, ~ta, pk(x) ) ▶₀ #i2 )
        case TEE_send
        by contradiction /* cyclic */
      qed
    qed
  next
    case case_2
    solve( St_TEE( $A, ~ta, pk(x) ) ▶₀ #i )
      case TEE_send
      solve( St_TEE( $A.1, ~ta, pk(x) ) ▶₀ #i2 )
        case TEE_send
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

