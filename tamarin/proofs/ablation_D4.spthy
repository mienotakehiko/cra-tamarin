lemma report_integrity:
  all-traces
  "∀ V A epoch L m #i.
    ((AcceptEntry( V, A, epoch, L, m ) @ #i) ∧
     (¬(∃ #r. (CompromisedLeaf( L ) @ #r) ∧ (#r < #i)))) ⇒
    (∃ n #j. (LeafAttested( L, A, V, epoch, n, m ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ V A epoch L m #i.
  (AcceptEntry( V, A, epoch, L, m ) @ #i)
 ∧
  (∀ #r. (CompromisedLeaf( L ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ n #j. (LeafAttested( L, A, V, epoch, n, m ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( AcceptEntry( V, A, epoch, L, m ) @ #i )
  case Verifier_ParseEntry_L1
  solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
    case Verifier_StartSession
    solve( !PkTPM( $A, pk(x) ) ▶₁ #i )
      case Register_AggrTPM
      solve( !PkLeaf( $L1, pk(x) ) ▶₂ #i )
        case Register_LeafDICE
        solve( !RosterOf( $A, $L1, $L2 ) ▶₃ #i )
          case Publish_Roster
          solve( !KU( sign(<'LEAF_EV', $L1, $A, $V, ~epoch, ~n, m>, ~cdi)
                 ) @ #vk.15 )
            case Leaf_Attest_case_1
            by contradiction /* from formulas */
          next
            case Leaf_Attest_case_2
            by contradiction /* from formulas */
          next
            case c_sign
            solve( !KU( ~cdi ) @ #vk.27 )
              case Compromise_LeafSw
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
next
  case Verifier_ParseEntry_L2
  solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
    case Verifier_StartSession
    solve( !PkTPM( $A, pk(x) ) ▶₁ #i )
      case Register_AggrTPM
      solve( !PkLeaf( $L2, pk(x) ) ▶₂ #i )
        case Register_LeafDICE
        solve( !RosterOf( $A, $L1, $L2 ) ▶₃ #i )
          case Publish_Roster
          solve( !KU( sign(<'LEAF_EV', $L2, $A, $V, ~epoch, ~n, m>, ~cdi)
                 ) @ #vk.19 )
            case Leaf_Attest_case_1
            by contradiction /* from formulas */
          next
            case Leaf_Attest_case_2
            by contradiction /* from formulas */
          next
            case c_sign
            solve( !KU( ~cdi ) @ #vk.27 )
              case Compromise_LeafSw
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma cryptographic_coverage:
  all-traces
  "∀ V A epoch evset L #i #j.
    (((((Accept( V, A, epoch, evset ) @ #i) ∧ (MemberOf( L, A ) @ #j)) ∧
       (#j < #i)) ∧
      (¬(∃ #r. (CompromisedLeaf( L ) @ #r) ∧ (#r < #i)))) ∧
     (¬(∃ #r. (RevealedTPM( A ) @ #r) ∧ (#r < #i)))) ⇒
    (∃ m #k.
      (AcceptEntry( V, A, epoch, L, m ) @ #k) ∧ ((#k < #i) ∨ (#k = #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ V A epoch evset L #i #j.
  (Accept( V, A, epoch, evset ) @ #i) ∧ (MemberOf( L, A ) @ #j)
 ∧
  (#j < #i) ∧
  (∀ #r. (CompromisedLeaf( L ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ #r. (RevealedTPM( A ) @ #r) ⇒ ¬(#r < #i)) ∧
  (∀ m #k.
    (AcceptEntry( V, A, epoch, L, m ) @ #k) ⇒ (¬(#k < #i)) ∧ (¬(#k = #i)))"
*/
simplify
solve( !Session( $V, $A, n, epoch ) ▶₀ #i )
  case Verifier_StartSession
  solve( !PkTPM( $A, pk(x) ) ▶₁ #i )
    case Register_AggrTPM
    solve( !RosterOf( $A, $L1, $L2 ) ▶₂ #i )
      case Publish_Roster
      solve( MemberOf( L, $A ) @ #j )
        case Publish_Roster_case_1
        solve( !KU( sign(<'AGG_EV', $A, $V, ~epoch, ~n, h(<m1, ev1, m2, ev2>), 
                          h(<$L1, $L2>)>,
                         ~aik)
               ) @ #vk.20 )
          case Aggregator_Quote_Fixed
          solve( !KU( sign(<'TPM', $A, 'g'^~ta, gb_in>, ~aik) ) @ #vk.41 )
            case TPM_respond
            solve( !KU( ~epoch ) @ #vk.24 )
              case Verifier_StartSession
              solve( !KU( ~n ) @ #vk.39 )
                case Verifier_StartSession
                solve( !KU( sign(<'TEE', $A, 'g'^~ta>, ~tsk) ) @ #vk.47 )
                  case TEE_send
                  solve( !KU( 'g'^~ta ) @ #vk.47 )
                    case TEE_send
                    solve( !KU( 'g'^~tb ) @ #vk.46 )
                      case TPM_respond
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

