/*
 * ============================================================================
 *  baseline.spthy
 *  Submission -- companion artifact (1/2)
 *
 *  Title    : Formal Analysis of Hierarchical Collective Remote Attestation
 *             with Heterogeneous TPM/DICE Roots of Trust in Tamarin
 *  Target   : IETF RATS (RFC 9334) Passport-model Composite Attester
 *             specialised to a two-level hierarchy:
 *                 Verifier --  Aggregator (TPM 2.0 + TEE)  --  Leaf (DICE)
 *
 *  Version  : baseline (intentionally weak on coverage-binding).
 *             The companion hardened model is `fixed.spthy`.
 *
 *  Verified with tamarin-prover 1.12.0 + maude 3.2.
 *
 *  Verified properties (all-traces unless noted):
 *      executability        [exists-trace]  proved
 *      key_secrecy                          proved
 *      injective_agree_TEE                  proved
 *      injective_agree_TPM                  proved
 *      freshness                            proved
 *      report_integrity                     proved
 *      cryptographic_coverage               FALSIFIED (attack trace)
 *
 *  The last lemma is the driver for the hardened protocol.
 * ============================================================================
 */

theory HierarchicalCRA_Baseline

begin

builtins:
    signing, hashing, diffie-hellman

/* ---------------------------------------------------------------------------
 *  Abstracted primitives
 *  ------------------------------------------------------------------------
 *  We rely on the built-in `sign/verify` and `h/1`; no extra function symbols
 *  are required.  We tag messages by string constants ('LEAF_EV', 'AGG_EV',
 *  ...) to keep the different signature contexts disjoint.
 * ------------------------------------------------------------------------- */


/* ===========================================================================
 *  1. Public-key infrastructure (Endorser role in RATS terms)
 *
 *  Three PKIs:
 *    - DICE attestation key on every leaf (long-term secret cdi)
 *    - AIK on every aggregator's TPM      (long-term secret aik)
 *    - TSK on every aggregator's TEE      (long-term secret tsk)
 *
 *  Uniqueness of enrollment is enforced by restrictions.
 * =========================================================================== */

rule Register_LeafDICE:
    [ Fr(~cdi) ]
  --[ EnrolledLeaf($L, ~cdi), OnlyOnceL($L) ]->
    [ !LtkLeaf($L, ~cdi), !PkLeaf($L, pk(~cdi)), Out(pk(~cdi)) ]

rule Register_AggrTPM:
    [ Fr(~aik) ]
  --[ EnrolledTPM($A, ~aik), OnlyOnceT($A) ]->
    [ !LtkTPM($A, ~aik), !PkTPM($A, pk(~aik)), Out(pk(~aik)) ]

rule Register_AggrTEE:
    [ Fr(~tsk) ]
  --[ EnrolledTEE($A, ~tsk), OnlyOnceE($A) ]->
    [ !LtkTEE($A, ~tsk), !PkTEE($A, pk(~tsk)), Out(pk(~tsk)) ]

/* Enrollment authority publishes membership of leaf L in aggregator A.
 * Persistent fact; action Member is recorded for use in the coverage lemma. */
rule Publish_Membership:
    [ !LtkLeaf($L, cdi), !LtkTPM($A, aik) ]
  --[ MemberOf($L, $A) ]->
    [ !Member($L, $A) ]


/* ===========================================================================
 *  2. Verifier -> Aggregator session initiation
 * =========================================================================== */

rule Verifier_StartSession:
    [ Fr(~n), Fr(~epoch) ]
  --[ SessionStart($V, $A, ~n, ~epoch), UniqueEpoch(~epoch) ]->
    [ Out(<'CHAL', $V, $A, ~n, ~epoch>),
      !Session($V, $A, ~n, ~epoch) ]


/* ===========================================================================
 *  3. TEE - TPM authenticated key establishment (signed Diffie-Hellman)
 *
 *  Both endpoints sign a transcript that includes:
 *      role ('TEE' / 'TPM'), aggregator id, their own ephemeral share,
 *      and (for TPM) the peer's share.
 *  Both signatures are then bound so that a shared key g^(a*b) is agreed.
 *
 *  NOTE (baseline): the transcript does NOT include the current epoch nor
 *  the challenge nonce.  A cross-session TEE reuse would be conceivable
 *  in more elaborate threat models; here we keep this simple and let the
 *  falsification arise elsewhere (coverage).
 * =========================================================================== */

rule TEE_send:
    [ !LtkTEE($A, tsk), !PkTPM($A, pkTpm), Fr(~a) ]
  --[ TEE_Started($A, 'g'^~a) ]->
    [ Out(< $A, 'TEE_HELLO', 'g'^~a,
            sign(<'TEE', $A, 'g'^~a>, tsk) >),
      St_TEE($A, ~a, pkTpm) ]

rule TPM_respond:
    let ga = ga_in
        gb = 'g'^~b
    in
    [ !LtkTPM($A, aik), !PkTEE($A, pkTee),
      In(< $A, 'TEE_HELLO', ga_in, sig_tee >),
      Fr(~b) ]
  --[ Eq(verify(sig_tee, <'TEE', $A, ga_in>, pkTee), true),
      AgreeTPM($A, ga, gb),
      Running_TPM($A, ga, gb) ]->
    [ Out(< $A, 'TPM_ACK', gb, sign(<'TPM', $A, ga, gb>, aik) >),
      St_TPM($A, ~b, ga) ]

rule TEE_finish:
    let ga = 'g'^~a
        k  = gb_in^~a
    in
    [ St_TEE($A, ~a, pkTpm),
      In(< $A, 'TPM_ACK', gb_in, sig_tpm >) ]
  --[ Eq(verify(sig_tpm, <'TPM', $A, ga, gb_in>, pkTpm), true),
      AgreeTEE($A, ga, gb_in),
      Commit_TEE($A, ga, gb_in),
      SessionKey($A, k),
      SecretKey(k) ]->
    [ !TEETPMKey($A, k) ]


/* ===========================================================================
 *  4. Leaf attestation (DICE)
 * =========================================================================== */

rule Leaf_Attest:
    [ !LtkLeaf($L, cdi), !Member($L, $A),
      In(<'CHAL', $V, $A, n, epoch>),
      Fr(~m) ]
  --[ LeafAttested($L, $A, $V, epoch, n, ~m),
      LeafMeasurement($L, ~m) ]->
    [ Out(< 'LEAF_EV', $L, $A,
            sign(<'LEAF_EV', $L, $A, $V, epoch, n, ~m>, cdi) >) ]


/* ===========================================================================
 *  5. Aggregator: collect leaf evidence, ask TPM to Quote
 * ===========================================================================
 *  BASELINE weakness (deliberate).
 *  --------------------------------
 *  The TPM Quote payload here is
 *
 *      <'AGG_EV', A, V, epoch, n>
 *
 *  and does NOT commit to
 *      (a) the hash of the child-evidence-set actually forwarded, nor
 *      (b) the hash of the expected roster.
 *
 *  This lets a Dolev-Yao adversary silently drop a leaf's LEAF_EV from
 *  the network before the aggregator sees it: the aggregator still
 *  produces a valid Quote for the (V, epoch, n) triple, and the verifier
 *  cannot tell the leaf's evidence is missing.
 *
 *  The rule "Aggregator_Quote" produces the Quote regardless of the
 *  child-evidence set.  We record the packed evidence set in an action
 *  ForwardedEvSet so that lemmas can talk about which leaves the
 *  aggregator saw.
 * --------------------------------------------------------------------------- */

rule Aggregator_Quote:
    [ !LtkTPM($A, aik),
      !TEETPMKey($A, k),
      In(<'CHAL', $V, $A, n, epoch>),
      In(evset) ]
  --[ AggrQuoted($A, $V, epoch, n, evset),
      UsedKey($A, k) ]->
    [ Out(< 'AGG_REPORT', $A, $V, epoch,
            evset,
            sign(<'AGG_EV', $A, $V, epoch, n>, aik) >) ]


/* ===========================================================================
 *  6. Verifier decisions
 *
 *  The verifier accepts a report if the AIK signature verifies against the
 *  session's (V, epoch, n).  It emits AcceptEntry(V, A, epoch, L, m) for
 *  each leaf signature it can parse out of the forwarded evset.
 *
 *  Splitting the two rules keeps the coverage lemma statable independently
 *  of per-leaf integrity.
 * =========================================================================== */

rule Verifier_AcceptAggregate:
    [ !Session($V, $A, n, epoch),
      !PkTPM($A, pkTpm),
      In(< 'AGG_REPORT', $A, $V, epoch, evset, sig_agg >) ]
  --[ Eq(verify(sig_agg, <'AGG_EV', $A, $V, epoch, n>, pkTpm), true),
      Accept($V, $A, epoch, evset),
      AcceptedFrom($V, $A, epoch, n) ]->
    [ ]

rule Verifier_ParseEntry:
    [ !Session($V, $A, n, epoch),
      !PkLeaf($L, pkL),
      !Member($L, $A),
      In(<'LEAF_EV', $L, $A, sig>),
      In(m) ]
  --[ Eq(verify(sig, <'LEAF_EV', $L, $A, $V, epoch, n, m>, pkL), true),
      AcceptEntry($V, $A, epoch, $L, m) ]->
    [ ]


/* ===========================================================================
 *  7. Adversary compromise capabilities
 * =========================================================================== */

rule Reveal_LtkTPM:
    [ !LtkTPM($A, aik) ] --[ RevealedTPM($A) ]-> [ Out(aik) ]

rule Reveal_LtkTEE:
    [ !LtkTEE($A, tsk) ] --[ RevealedTEE($A) ]-> [ Out(tsk) ]

rule Compromise_LeafSw:
    [ !LtkLeaf($L, cdi) ] --[ CompromisedLeaf($L) ]-> [ Out(cdi) ]


/* ===========================================================================
 *  8. Restrictions
 * =========================================================================== */

restriction Equality:
    " All x y #i. Eq(x, y) @ i ==> x = y "

restriction Unique_LeafEnrollment:
    " All L #i #j. OnlyOnceL(L) @ i & OnlyOnceL(L) @ j ==> #i = #j "

restriction Unique_TPMEnrollment:
    " All A #i #j. OnlyOnceT(A) @ i & OnlyOnceT(A) @ j ==> #i = #j "

restriction Unique_TEEEnrollment:
    " All A #i #j. OnlyOnceE(A) @ i & OnlyOnceE(A) @ j ==> #i = #j "

restriction Unique_Epoch:
    " All e #i #j. UniqueEpoch(e) @ i & UniqueEpoch(e) @ j ==> #i = #j "


/* ===========================================================================
 *  9. Sources lemma
 *
 *  For each origin of a leaf-attestation signature we tell Tamarin either
 *  the leaf produced it honestly (LeafAttested action recorded), or the
 *  adversary knew the CDI beforehand (a KU-fact chain).  This resolves the
 *  partial deconstructions triggered by Verifier_ParseEntry pattern-matching
 *  on sign(...) directly out of the network.
 * =========================================================================== */

/* Sources lemma is not required in this model: the verifier's
 * parsing rule already forces signature verification via the `verify`
 * predicate, so Tamarin's constraint solver can trace `AcceptEntry` back
 * to either an honest `LeafAttested` or an adversary-known CDI, both of
 * which the built-in DY solver handles without a manual sources hint.
 * We therefore omit the [sources] lemma and rely on the automatic
 * partial-deconstruction resolution.                                    */


/* ===========================================================================
 * 10. Security properties
 * =========================================================================== */

/* ---- (a) Sanity : an honest run reaches Verifier_Accept ---- */

lemma executability:
    exists-trace
    " Ex V A epoch evset #i.
          Accept(V, A, epoch, evset) @ i
        & not (Ex X #j. RevealedTPM(X) @ j)
        & not (Ex X #j. RevealedTEE(X) @ j)
        & not (Ex X #j. CompromisedLeaf(X) @ j) "

/* ---- (b) TEE-TPM session key secrecy ---- */

lemma key_secrecy:
    " All A k #i.
          SessionKey(A, k) @ i
        & not (Ex #j. RevealedTPM(A) @ j)
        & not (Ex #j. RevealedTEE(A) @ j)
      ==>
          not (Ex #m. K(k) @ m) "

/* ---- (c) Injective agreement, TEE's view of TPM ---- */

lemma injective_agree_TEE:
    " All A ga gb #i.
          Commit_TEE(A, ga, gb) @ i
        & not (Ex #r. RevealedTPM(A) @ r & r < i)
      ==>
          ( Ex #j. Running_TPM(A, ga, gb) @ j & j < i )
        & not ( Ex A2 #i2.
                    Commit_TEE(A2, ga, gb) @ i2 & not (#i = #i2) ) "

/* ---- (d) Freshness of accepted aggregate reports ---- */

lemma freshness:
    " All V A epoch n #i.
          AcceptedFrom(V, A, epoch, n) @ i
        & not (Ex #r. RevealedTPM(A) @ r & r < i)
      ==>
          Ex #j. SessionStart(V, A, n, epoch) @ j & j < i "

/* ---- (e) Per-leaf report integrity ---- */

lemma report_integrity:
    " All V A epoch L m #i.
          AcceptEntry(V, A, epoch, L, m) @ i
        & not (Ex #r. CompromisedLeaf(L) @ r & r < i)
      ==>
          Ex n #j. LeafAttested(L, A, V, epoch, n, m) @ j & j < i "

/* ---- (f) Cryptographic coverage : EXPECTED TO FALSIFY ---- *
 *
 *  If a verifier accepts an aggregate for A@epoch and L is a registered
 *  member of A that is *not* compromised, then the verifier must have
 *  parsed a fresh leaf evidence for L in that same session.
 *
 *  In this baseline the aggregator's Quote does not commit to the child
 *  evidence set, so an on-path adversary can drop LEAF_EV(L) between L and
 *  A and the verifier will still Accept.  Tamarin should produce an attack
 *  trace here that we cite as Figure 3 of the paper.
 * --------------------------------------------------------------------- */

lemma cryptographic_coverage:
    " All V A epoch evset L #i #j.
          Accept(V, A, epoch, evset) @ i
        & MemberOf(L, A) @ j
        & j < i
        & not (Ex #r. CompromisedLeaf(L) @ r & r < i)
        & not (Ex #r. RevealedTPM(A) @ r & r < i)
      ==>
          Ex m #k. AcceptEntry(V, A, epoch, L, m) @ k & k < i "

end
/* =========================== END OF FILE =============================== */
